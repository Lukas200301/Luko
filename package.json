{
  "name": "luko",
  "version": "2.0.0",
  "description": "Multi-purpose Discord Bot",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:panel": "vite --config panel/vite.config.mts",
    "prebuild": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc && npm run build:panel",
    "build:panel": "vite build --config panel/vite.config.mts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p panel",
    "pm2:start": "npm run build && pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:logs": "pm2 logs luko",
    "panel:reset": "tsx src/tools/reset-panel.ts"
  },
  "keywords": [
    "discord",
    "bot",
    "discord.js"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.7",
    "@resvg/resvg-js": "^2.6.2",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "pm2": "^7.1.1",
    "shoukaku": "^4.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
