# --- Bot identity (required) ---
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
DEV_GUILD_ID=your_dev_server_id_here
OWNER_ID=your_discord_user_id_here

# --- Lavalink ---
# Host and port are set in the admin panel (Settings); only the password lives here.
LAVALINK_PASSWORD=youshallnotpass

# YouTube OAuth (Bypasses "Sign in to confirm you're not a bot")
YOUTUBE_REFRESH_TOKEN=

# Spotify Integration via LavaSrc (From developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Admin panel login (set at least one) ---
# Discord login: the client secret from Discord Developer Portal -> OAuth2.
# Also add http://<server-ip>:5000/auth/callback (or https://your-domain/auth/callback) under OAuth2 -> Redirects.
DISCORD_CLIENT_SECRET=
# Password login: signs you in as the owner. Use a long random password.
PANEL_PASSWORD=

# --- Legacy settings (optional) ---
# Everything below now lives in the database (data/luko.db) and is changed in the admin panel.
# These values are only read once, when the settings are created for the first time.
# MUSIC_ENABLED=true
# LAVALINK_HOST=localhost
# LAVALINK_PORT=2333
# PINBOARD_GUILD_ID=your_guild_id
# PINBOARD_CHANNEL_ID=your_channel_id
# PINBOARD_EMOJIS="emoji_id_1,emoji_id_2"
# PINBOARD_EMOJI_DISPLAYS="<:emoji1:id1>,<:emoji2:id2>"
# PINBOARD_THRESHOLD=5